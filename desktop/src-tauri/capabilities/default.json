{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TokenMeter Desktop 默认能力：允许调用打包的 tokenmeter sidecar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/tokenmeter",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
